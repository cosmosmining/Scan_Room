<?xml version="1.0" encoding="UTF-8"?>
<!-- The app's privacy manifest, which App Store Connect requires before it
     accepts a build (TestFlight included). The app does no tracking and sends
     nothing to anyone but the MOZU server the user points it at. It reads its
     own settings (the server address, the steady-lines switch) through
     UserDefaults, which Apple lists as a "required reason" API: CA92.1 is
     "access information from the same app". -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
