# Enables the camera "Scan room" AI estimate (Google Gemini — free tier, no billing).
# Get a free key at https://aistudio.google.com/apikey
# Copy this file to .env.local, paste your key, then restart the server.
# .env.local is gitignored — keep the key secret.
GEMINI_API_KEY=

# Optional: override the model (defaults to gemini-2.0-flash).
# GEMINI_MODEL=gemini-2.0-flash
